# Copy to .env (backend/.env for local dev) and adjust.
ADMIN_PASSWORD=change-me            # enables the admin panel; unset = read-only deployment
SECRET_KEY=                         # optional; random per start when empty (tokens expire on restart)
EXTRACTOR=auto                      # auto | rule | spacy | gliner
DATA_DIR=data                       # SQLite database + seed corpora
FRONTEND_DIST=                      # path of the built SPA to serve from FastAPI (set in the full-stack image)
CORS_ORIGINS=["http://localhost:5173"]
